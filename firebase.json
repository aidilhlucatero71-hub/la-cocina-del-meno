{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "LEEME.md", "**/.*"],
    "cleanUrls": true,
    "headers": [
      { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
      { "source": "**/*.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
